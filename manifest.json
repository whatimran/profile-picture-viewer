{
  "manifest_version": 3,
  "name": "Profile Picture Viewer",
  "version": "1.0.0",
  "description": "View full-size profile pictures from Facebook. Click the icon for a nice popup with a button. by Imran (https://imranshah.netlify.app/)",
  "author": "Imran - https://imranshah.netlify.app/",
  "permissions": [
    "contextMenus",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.messenger.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    },
    "default_title": "Profile Picture Viewer",
    "default_popup": "popup.html"
  }
}
